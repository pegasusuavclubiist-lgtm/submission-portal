# Copy to .env.local for local development. On Vercel, add these in
# Project Settings -> Environment Variables.

# Postgres connection string (Neon). Added automatically if you create the
# database through the Vercel Marketplace integration.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Password for /admin
ADMIN_PASSWORD="change-me-to-something-long-and-random"

# Secret used to sign the admin session cookie (generate with: openssl rand -hex 32)
ADMIN_SESSION_SECRET="change-me-too"

# Submission deadline. Use ISO 8601 WITH a UTC offset so there is no ambiguity.
# Example: 18:00 India Standard Time on 12 Oct 2026
SUBMISSION_DEADLINE="2026-10-12T18:00:00+05:30"

# Time zone used when DISPLAYING times (IANA name). Does not affect the late logic.
EVENT_TIMEZONE="Asia/Kolkata"
